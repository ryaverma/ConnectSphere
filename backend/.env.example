# Docker Compose environment (copy to backend/.env and set your own values).
# docker compose reads backend/.env automatically.
# Use the same passwords in node-service/.env and python-service/.env connection URLs.

# MongoDB root user (username: admin)
MONGO_ROOT_PASSWORD=change_me_mongo_root_password
# MongoDB app user "connectsphere_app" (created by scripts/mongo-init.js on first start)
MONGO_APP_PASSWORD=change_me_mongo_app_password

# Redis (exposed on host port 6380)
REDIS_PASSWORD=change_me_redis_password

# Neo4j (username: neo4j)
NEO4J_PASSWORD=change_me_neo4j_password
